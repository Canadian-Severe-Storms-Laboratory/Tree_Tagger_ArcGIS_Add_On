<UserControl x:Class="TreeTaggerModule.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreeTaggerModule"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="50">
    <Grid>
        <TextBox HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=NumberString, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" FontSize="11" Width="50" Height="20"/>
    </Grid>
</UserControl>
